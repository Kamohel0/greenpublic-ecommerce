# GreenPublic Backend Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to git!

# ===== DATABASE (MySQL) =====
# Local MySQL:
DB_URL=jdbc:mysql://localhost:3306/greenpublic?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=greenpublic
DB_PASSWORD=your_database_password_here

# ===== LOCAL DEVELOPMENT =====
# Skip the email verification step so you can log in straight after signing up.
# Remove this line on the server.
app.registration.activate-immediately=true

# ===== JWT AUTHENTICATION =====
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# ===== YOCO PAYMENT GATEWAY =====
# Get keys from: https://dashboard.yoco.com/settings/developers
# For Testing (starts with sk_test_ and pk_test_):
YOCO_API_SECRET_KEY=sk_test_your_secret_key_here
YOCO_API_PUBLIC_KEY=pk_test_your_public_key_here

# For Production (starts with sk_live_ and pk_live_):
# YOCO_API_SECRET_KEY=sk_live_your_secret_key_here
# YOCO_API_PUBLIC_KEY=pk_live_your_public_key_here

# ===== YOCO WEBHOOKS =====
# This will be auto-set by ngrok in dev or your domain in production
YOCO_WEBHOOK_URL=https://your-domain.com/api/webhook/yoco
YOCO_WEBHOOK_SECRET=whsec_your_webhook_secret_from_yoco

# ===== EMAIL (Gmail SMTP) =====
# For Gmail: Use App Password, not your actual password
# Generate at: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# ===== AWS CREDENTIALS =====
# Get from AWS IAM Console
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=af-south-1
AWS_S3_BUCKET=greenpublicimages

# ===== GOOGLE OAUTH2 =====
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===== URLS =====
# Only needed for the default/dev profile; the prod profile uses greenpublic.duckdns.org
# PUBLIC_BASE_URL=http://localhost:8080
# FRONTEND_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# ===== SPRING PROFILE =====
# The profile can't be set from this file. Set it as a real environment variable
# (export SPRING_PROFILES_ACTIVE=prod, or Environment= in the systemd unit) or run
#   java -jar ecommerce.jar --spring.profiles.active=prod
# Always use "prod" on the server: the "dev" profile enables debug endpoints.
