# Frontend production environment (Vite)
# Use this for production builds

# Production: use same-origin and let Nginx proxy /api to backend
# Leave empty to keep requests relative (e.g., /api/auth/login)
VITE_API_BASE_URL=

# Yoco public key (set the real value on the build machine, not in git).
# Demo/portfolio: use a pk_test_ key so visitors can't make real payments.
VITE_YOCO_PUBLIC_KEY=pk_test_your_public_key_here
