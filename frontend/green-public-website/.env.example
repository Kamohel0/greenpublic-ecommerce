# Frontend environment example (Vite). Copy to .env.local for local development.

# Backend API. Leave empty in production so requests go to /api on the same domain (Nginx proxies it).
VITE_API_BASE_URL=http://localhost:8080

# Yoco public key. Use a pk_test_ key for the portfolio demo so no real payments can be made.
VITE_YOCO_PUBLIC_KEY=pk_test_your_public_key_here
